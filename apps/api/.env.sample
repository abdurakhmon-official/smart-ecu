NODE_ENV=development
STAGE=local
PORT=9100
CREDENTIALS=true

WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

PUBLIC_URL=

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

DATABASE_URL=postgresql://user:password@host:5432/app
# Jest'dagi *.spec.ts fayllar shu bazaga ishlaydi — dev DATABASE_URL bilan bir xil bo'lmasin,
# aks holda test run'lar (beforeEach truncate) dev ma'lumotlarini o'chirib yuboradi.
DATABASE_URL_TEST=postgresql://user:password@host:5432/app_test

SWAGGER_ENABLED=true
SWAGGER_PATH=/docs

REDIS_URL=redis://127.0.0.1:6379

AWS_REGION=eu-central-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_FILE_VIEW_EXPIRY=3600

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=App <no-reply@example.com>

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me

# AI Assistant (Bosqich 4) — Anthropic Claude API
ANTHROPIC_API_KEY=

# Xarita (Bosqich 2) — Yandex Maps JS API + Geocoder
YANDEX_MAPS_API_KEY=

# To'lovlar (Bosqich 7) — Payme Business Merchant API
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# To'lovlar (Bosqich 7) — Click.uz Shop API
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay

# Telegram bot (Bosqich 7) — @BotFather orqali yaratiladi
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
