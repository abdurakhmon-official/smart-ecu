generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

generator zod {
  provider                  = "zod-prisma-types"
  output                    = "../generated/zod"
  createRelationValuesTypes = "true"
  useMultipleFiles          = "true"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum USER_ROLE {
  CUSTOMER
  SERVICE
  TUNER
  ADMIN
  SUPER_ADMIN
}

enum FUEL_TYPE {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  LPG
}

enum TRANSMISSION_TYPE {
  MANUAL
  AUTOMATIC
  CVT
  ROBOT
}

enum SERVICE_STATUS {
  PENDING
  VERIFIED
  SUSPENDED
}

enum ORDER_STATUS {
  NEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NOTIFICATION_TYPE {
  ORDER_RECEIVED
  ORDER_ACCEPTED
  ORDER_COMPLETED
  ORDER_CANCELLED
  REVIEW_RECEIVED
  ADMIN_BROADCAST
  TUNING_ORDER_RECEIVED
  TUNING_ORDER_STATUS_CHANGED
}

enum AI_MESSAGE_ROLE {
  USER
  ASSISTANT
}

enum TUNING_ORDER_STATUS {
  NEW
  IN_PROGRESS
  WAITING_FOR_LOG
  READY
  COMPLETED
  CANCELLED
}

enum ECU_FILE_KIND {
  ORIGINAL
  MODIFIED
  LOG
}

enum SUBSCRIPTION_PLAN {
  FREE
  PRO
  BUSINESS
}

enum SUBSCRIPTION_STATUS {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PAYMENT_PROVIDER {
  PAYME
  CLICK
}

enum PAYMENT_STATUS {
  PENDING
  PAID
  CANCELLED
  FAILED
}

enum REPORT_SEVERITY {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                String    @id @default(uuid())
  fullName          String    @map("full_name")
  email             String    @unique
  password          String
  role              USER_ROLE @default(CUSTOMER)
  phone             String?
  avatar            String?
  locale            String    @default("en")
  emailVerified     Boolean   @default(false) @map("email_verified")
  passwordChangedAt DateTime? @map("password_changed_at")
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  twoFactorSecret    String?   @map("two_factor_secret")
  twoFactorEnabledAt DateTime? @map("two_factor_enabled_at")

  telegramChatId String? @unique @map("telegram_chat_id")

  vehicles             UserVehicle[]
  serviceProvider      ServiceProvider?
  orders               Order[]
  reviews              Review[]
  notifications        Notification[]
  aiConversation       AiConversation?
  twoFactorBackupCodes TwoFactorBackupCode[]
  auditLogs            AuditLog[]
  tunerProfile         TunerProfile?
  tuningOrders         TuningOrder[]
  uploadedEcuFiles     EcuFile[]
  subscription         Subscription?
  payments             Payment[]
  reportAnalyses       ServiceReportAnalysis[]

  @@index([email])
  @@map("users")
}

model Brand {
  id        String   @id @default(uuid())
  name      String   @unique
  logo      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  models           Model[]
  serviceProviders ServiceProvider[]
  tunerProfiles    TunerProfile[]

  @@map("brands")
}

model Model {
  id        String   @id @default(uuid())
  brandId   String   @map("brand_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  generations Generation[]

  @@unique([brandId, name])
  @@index([brandId])
  @@map("models")
}

model Generation {
  id        String   @id @default(uuid())
  modelId   String   @map("model_id")
  name      String
  yearFrom  Int      @map("year_from")
  yearTo    Int?     @map("year_to")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  model   Model          @relation(fields: [modelId], references: [id], onDelete: Cascade)
  engines EngineOption[]

  @@unique([modelId, name])
  @@index([modelId])
  @@map("generations")
}

model EngineOption {
  id           String            @id @default(uuid())
  generationId String            @map("generation_id")
  name         String
  volumeLiters Float?            @map("volume_liters")
  fuel         FUEL_TYPE
  transmission TRANSMISSION_TYPE
  powerHp      Int?              @map("power_hp")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  generation   Generation    @relation(fields: [generationId], references: [id], onDelete: Cascade)
  userVehicles UserVehicle[]

  @@unique([generationId, name])
  @@index([generationId])
  @@map("engine_options")
}

model UserVehicle {
  id             String  @id @default(uuid())
  userId         String  @map("user_id")
  engineOptionId String? @map("engine_option_id")

  customBrand String? @map("custom_brand")
  customModel String? @map("custom_model")
  customYear  Int?    @map("custom_year")

  vin         String?
  plateNumber String? @map("plate_number")
  mileageKm   Int?    @map("mileage_km")
  photo       String?
  isPrimary   Boolean @default(false) @map("is_primary")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  engineOption EngineOption? @relation(fields: [engineOptionId], references: [id], onDelete: SetNull)
  orders       Order[]
  tuningOrders TuningOrder[]

  @@index([userId])
  @@index([engineOptionId])
  @@map("user_vehicles")
}

model ServiceProvider {
  id           String         @id @default(uuid())
  userId       String         @unique @map("user_id")
  name         String
  description  String?
  logo         String?
  city         String
  address      String?
  lat          Float?
  lng          Float?
  phone        String
  telegram     String?
  whatsapp     String?
  instagram    String?
  workingHours String?        @map("working_hours")
  status       SERVICE_STATUS @default(PENDING)
  ratingAvg    Float          @default(0) @map("rating_avg")
  ratingCount  Int            @default(0) @map("rating_count")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  offerings       ServiceOffering[]
  brands          Brand[]
  orderRecipients OrderRecipient[]
  acceptedOrders  Order[]           @relation("AcceptedOrders")
  reviews         Review[]

  @@index([city])
  @@index([status])
  @@map("service_providers")
}

model ServiceCatalogItem {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        Json
  description Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  offerings    ServiceOffering[]
  orders       Order[]
  tuningOrders TuningOrder[]

  @@map("service_catalog_items")
}

model ServiceOffering {
  id                   String   @id @default(uuid())
  serviceProviderId    String   @map("service_provider_id")
  serviceCatalogItemId String   @map("service_catalog_item_id")
  priceMin             Int?     @map("price_min")
  priceMax             Int?     @map("price_max")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  serviceProvider    ServiceProvider    @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)
  serviceCatalogItem ServiceCatalogItem @relation(fields: [serviceCatalogItemId], references: [id], onDelete: Cascade)

  @@unique([serviceProviderId, serviceCatalogItemId])
  @@index([serviceProviderId])
  @@index([serviceCatalogItemId])
  @@map("service_offerings")
}

model Order {
  id                        String       @id @default(uuid())
  userId                    String       @map("user_id")
  userVehicleId             String?      @map("user_vehicle_id")
  serviceCatalogItemId      String       @map("service_catalog_item_id")
  problemDescription        String       @map("problem_description")
  city                      String
  phone                     String
  status                    ORDER_STATUS @default(NEW)
  acceptedServiceProviderId String?      @map("accepted_service_provider_id")
  createdAt                 DateTime     @default(now()) @map("created_at")
  updatedAt                 DateTime     @updatedAt @map("updated_at")

  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userVehicle             UserVehicle?       @relation(fields: [userVehicleId], references: [id], onDelete: SetNull)
  serviceCatalogItem      ServiceCatalogItem @relation(fields: [serviceCatalogItemId], references: [id], onDelete: Restrict)
  acceptedServiceProvider ServiceProvider?   @relation("AcceptedOrders", fields: [acceptedServiceProviderId], references: [id], onDelete: SetNull)
  recipients              OrderRecipient[]
  notifications           Notification[]
  review                  Review?

  @@index([userId])
  @@index([userVehicleId])
  @@index([serviceCatalogItemId])
  @@index([acceptedServiceProviderId])
  @@index([status])
  @@map("orders")
}

model OrderRecipient {
  id                String   @id @default(uuid())
  orderId           String   @map("order_id")
  serviceProviderId String   @map("service_provider_id")
  createdAt         DateTime @default(now()) @map("created_at")

  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceProvider ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)

  @@unique([orderId, serviceProviderId])
  @@index([orderId])
  @@index([serviceProviderId])
  @@map("order_recipients")
}

model Review {
  id                String   @id @default(uuid())
  orderId           String   @unique @map("order_id")
  userId            String   @map("user_id")
  serviceProviderId String   @map("service_provider_id")
  rating            Int
  comment           String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceProvider ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([serviceProviderId])
  @@map("reviews")
}

model Notification {
  id               String            @id @default(uuid())
  userId           String            @map("user_id")
  type             NOTIFICATION_TYPE
  orderId          String?           @map("order_id")
  broadcastMessage Json?             @map("broadcast_message")
  readAt           DateTime?         @map("read_at")
  createdAt        DateTime          @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@map("notifications")
}

model AiConversation {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@map("ai_conversations")
}

model AiMessage {
  id             String          @id @default(uuid())
  conversationId String          @map("conversation_id")
  role           AI_MESSAGE_ROLE
  content        String
  createdAt      DateTime        @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model TwoFactorBackupCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_backup_codes")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model TunerProfile {
  id           String         @id @default(uuid())
  userId       String         @unique @map("user_id")
  name         String
  description  String?
  logo         String?
  city         String
  address      String?
  lat          Float?
  lng          Float?
  phone        String
  telegram     String?
  whatsapp     String?
  instagram    String?
  workingHours String?        @map("working_hours")
  status       SERVICE_STATUS @default(PENDING)
  ratingAvg    Float          @default(0) @map("rating_avg")
  ratingCount  Int            @default(0) @map("rating_count")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  brands Brand[]
  orders TuningOrder[]

  @@index([city])
  @@index([status])
  @@map("tuner_profiles")
}

model TuningOrder {
  id                    String              @id @default(uuid())
  tunerId               String              @map("tuner_id")
  userId                String              @map("user_id")
  userVehicleId         String?             @map("user_vehicle_id")
  serviceCatalogItemId  String              @map("service_catalog_item_id")
  problemDescription    String              @map("problem_description")
  status                TUNING_ORDER_STATUS @default(NEW)
  powerBeforeHp         Int?                @map("power_before_hp")
  powerAfterHp          Int?                @map("power_after_hp")
  torqueBeforeNm        Int?                @map("torque_before_nm")
  torqueAfterNm         Int?                @map("torque_after_nm")
  fuelConsumptionBefore Float?              @map("fuel_consumption_before")
  fuelConsumptionAfter  Float?              @map("fuel_consumption_after")
  resultsVerified       Boolean             @default(false) @map("results_verified")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  tuner              TunerProfile       @relation(fields: [tunerId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userVehicle        UserVehicle?       @relation(fields: [userVehicleId], references: [id], onDelete: SetNull)
  serviceCatalogItem ServiceCatalogItem @relation(fields: [serviceCatalogItemId], references: [id], onDelete: Restrict)
  files              EcuFile[]

  @@index([tunerId])
  @@index([userId])
  @@index([status])
  @@map("tuning_orders")
}

model EcuFile {
  id            String        @id @default(uuid())
  tuningOrderId String        @map("tuning_order_id")
  kind          ECU_FILE_KIND
  storageKey    String        @map("storage_key")
  originalName  String        @map("original_name")
  ecuId         String?       @map("ecu_id")
  software      String?
  hardware      String?
  checksum      String?
  uploadedById  String        @map("uploaded_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  tuningOrder TuningOrder @relation(fields: [tuningOrderId], references: [id], onDelete: Cascade)
  uploadedBy  User        @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([tuningOrderId])
  @@map("ecu_files")
}

model Subscription {
  id               String              @id @default(uuid())
  userId           String              @unique @map("user_id")
  plan             SUBSCRIPTION_PLAN   @default(FREE)
  status           SUBSCRIPTION_STATUS @default(ACTIVE)
  currentPeriodEnd DateTime?           @map("current_period_end")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id                    String            @id @default(uuid())
  userId                String            @map("user_id")
  subscriptionId        String?           @map("subscription_id")
  plan                  SUBSCRIPTION_PLAN
  provider              PAYMENT_PROVIDER
  providerTransactionId String?           @map("provider_transaction_id")
  amount                Int
  status                PAYMENT_STATUS    @default(PENDING)
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([provider, providerTransactionId])
  @@map("payments")
}

model ServiceReportAnalysis {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  storageKey String           @map("storage_key")
  severity   REPORT_SEVERITY?
  summary    String?
  createdAt  DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("service_report_analyses")
}
